+//! Recovery UI state and service adapter. Never edits journals or files itself.
+use super::errors::UiError;
+use sonata_launcher_core::{GlobalState, instance::model::InstanceId};
+use std::sync::Arc;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RecoveryAction {
+    Retry,
+    Abandon(String),
+}
+#[derive(Debug, Clone)]
+pub struct RecoveryRequest {
+    pub instance: InstanceId,
+    pub generation: u64,
+    pub action: RecoveryAction,
+}
+
+pub struct RecoveryState {
+    instance: InstanceId,
+    generation: u64,
+    pub pending: Vec<String>,
+    pub loading: bool,
+    pub busy: bool,
+    pub confirmation: Option<String>,
+    pub error: Option<UiError>,
+    action_error: bool,
+}
+impl RecoveryState {
+    pub fn new(instance: InstanceId) -> Self {
+        Self {
+            instance,
+            generation: 0,
+            pending: vec![],
+            loading: false,
+            busy: false,
+            confirmation: None,
+            error: None,
+            action_error: false,
+        }
+    }
+    fn advance(&mut self) -> u64 {
+        self.generation = self
+            .generation
+            .checked_add(1)
+            .expect("recovery generation exhausted");
+        self.generation
+    }
+    pub fn load(&mut self) -> Option<u64> {
+        if self.loading || self.busy {
+            return None;
+        }
+        self.loading = true;
+        Some(self.advance())
+    }
+    pub fn loaded(&mut self, generation: u64, result: Result<Vec<String>, UiError>) {
+        if generation != self.generation || !self.loading || self.busy {
+            return;
+        }
+        self.loading = false;
+        self.apply(result, !self.action_error);
+    }
+    fn apply(&mut self, result: Result<Vec<String>, UiError>, clear_error: bool) {
+        match result {
+            Ok(pending) => {
+                self.pending = pending;
+                if clear_error {
+                    self.error = None;
+                }
+                if self
+                    .confirmation
+                    .as_ref()
+                    .is_some_and(|id| !self.pending.contains(id))
+                {
+                    self.confirmation = None;
+                }
+            }
+            Err(error) => self.error = Some(error),
+        }
+    }
+    pub fn ask_abandon(&mut self, operation: String) {
+        if !self.loading && !self.busy && self.pending.contains(&operation) {
+            self.confirmation = Some(operation);
+        }
+    }
+    pub fn begin(&mut self, action: RecoveryAction) -> Option<RecoveryRequest> {
+        if self.loading || self.busy || self.pending.is_empty() {
+            return None;
+        }
+        if let RecoveryAction::Abandon(operation) = &action {
+            if self.confirmation.as_ref() != Some(operation) || !self.pending.contains(operation) {
+                return None;
+            }
+        }
+        self.busy = true;
+        self.error = None;
+        self.confirmation = None;
+        self.action_error = false;
+        Some(RecoveryRequest {
+            instance: self.instance,
+            generation: self.advance(),
+            action,
+        })
+    }
+    pub fn finished(&mut self, generation: u64, result: Result<Vec<String>, UiError>) {
+        if generation != self.generation || !self.busy {
+            return;
+        }
+        self.busy = false;
+        self.action_error = result.is_err();
+        self.apply(result, true);
+    }
+}
+
+pub async fn execute(
+    core: Arc<GlobalState>,
+    request: RecoveryRequest,
+) -> Result<Vec<String>, UiError> {
+    match request.action {
+        RecoveryAction::Retry => core
+            .content()
+            .retry_recovery(request.instance)
+            .await
+            .map_err(UiError::from)?,
+        RecoveryAction::Abandon(operation) => core
+            .content()
+            .abandon_recovery(request.instance, &operation)
+            .await
+            .map_err(UiError::from)?,
+    }
+    core.content()
+        .pending_recovery(request.instance)
+        .await
+        .map_err(UiError::from)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn abandon_requires_confirmation_and_stale_load_cannot_replace_action_result() {
+        let mut state = RecoveryState::new(7.into());
+        let load = state.load().unwrap();
+        state.loaded(load, Ok(vec!["one".into(), "two".into()]));
+        assert!(state.begin(RecoveryAction::Abandon("one".into())).is_none());
+        state.ask_abandon("foreign".into());
+        assert!(state.confirmation.is_none());
+        state.ask_abandon("one".into());
+        let request = state.begin(RecoveryAction::Abandon("one".into())).unwrap();
+        assert_eq!(request.instance, 7.into());
+        assert!(state.load().is_none());
+        assert!(state.begin(RecoveryAction::Retry).is_none());
+        state.loaded(load, Ok(vec![]));
+        assert_eq!(state.pending.len(), 2);
+        state.finished(request.generation, Ok(vec!["two".into()]));
+        state.finished(request.generation, Ok(vec![]));
+        assert_eq!(state.pending, ["two"]);
+    }
+    #[test]
+    fn conflict_preserves_pending_ids_and_typed_details_for_retry() {
+        let mut state = RecoveryState::new(7.into());
+        let load = state.load().unwrap();
+        state.loaded(load, Ok(vec!["one".into()]));
+        let request = state.begin(RecoveryAction::Retry).unwrap();
+        state.finished(
+            request.generation,
+            Err(
+                sonata_launcher_core::instance::content::error::ContentError::RecoveryConflict {
+                    name: "mod.jar".into(),
+                }
+                .into(),
+            ),
+        );
+        assert_eq!(state.pending, ["one"]);
+        assert_eq!(
+            state.error.as_ref().unwrap().kind,
+            super::super::errors::UiErrorKind::RecoveryRequired
+        );
+        assert!(state.error.as_ref().unwrap().details.contains("mod.jar"));
+        assert!(state.begin(RecoveryAction::Retry).is_some());
+    }
+    #[test]
+    fn successful_poll_retains_failed_action_diagnostic_until_next_action() {
+        use sonata_launcher_core::instance::content::error::ContentError;
+
+        let mut state = RecoveryState::new(7.into());
+        let load = state.load().unwrap();
+        state.loaded(load, Ok(vec!["one".into()]));
+        // A duplicate callback cannot replace the accepted list.
+        state.loaded(load, Ok(vec![]));
+        assert_eq!(state.pending, ["one"]);
+        let request = state.begin(RecoveryAction::Retry).unwrap();
+        state.finished(
+            request.generation,
+            Err(ContentError::RecoveryConflict {
+                name: "mod.jar".into(),
+            }
+            .into()),
+        );
+        let error = state.error.clone().unwrap();
+        let poll = state.load().unwrap();
+        state.loaded(poll, Ok(vec!["one".into(), "two".into()]));
+        assert_eq!(state.pending, ["one", "two"]);
+        let retained = state.error.as_ref().unwrap();
+        assert_eq!(retained.kind, error.kind);
+        assert_eq!(retained.details, error.details);
+        assert!(Arc::ptr_eq(
+            retained.source.as_ref().unwrap(),
+            error.source.as_ref().unwrap()
+        ));
+        assert!(matches!(
+            retained
+                .source
+                .as_ref()
+                .unwrap()
+                .downcast_ref::<ContentError>(),
+            Some(ContentError::RecoveryConflict { .. })
+        ));
+        let retry = state.begin(RecoveryAction::Retry).unwrap();
+        assert!(state.error.is_none());
+        state.finished(retry.generation, Ok(vec![]));
+        let poll = state.load().unwrap();
+        state.loaded(poll, Ok(vec![]));
+        assert!(state.error.is_none());
+        assert!(!state.busy);
+    }
+    #[async_std::test]
+    async fn adapter_uses_public_service_and_preserves_files_on_rejected_action() {
+        let root = tempfile::tempdir().unwrap();
+        let core = Arc::new(
+            GlobalState::new(sonata_launcher_core::Config {
+                root_override: Some(root.path().into()),
+                discover_java_on_startup: false,
+                ..sonata_launcher_core::Config::init()
+            })
+            .await
+            .unwrap(),
+        );
+        let instance = core
+            .instances()
+            .create(
+                "recovery fixture".into(),
+                "1.20.1".into(),
+                "https://example.invalid/manifest".into(),
+                "prism".into(),
+            )
+            .await
+            .unwrap();
+        let file = root.path().join("preserved.jar");
+        std::fs::write(&file, b"user bytes").unwrap();
+        assert!(
+            execute(
+                core.clone(),
+                RecoveryRequest {
+                    instance: instance.id,
+                    generation: 1,
+                    action: RecoveryAction::Retry
+                }
+            )
+            .await
+            .unwrap()
+            .is_empty()
+        );
+        assert!(
+            execute(
+                core.clone(),
+                RecoveryRequest {
+                    instance: instance.id,
+                    generation: 2,
+                    action: RecoveryAction::Abandon("unknown".into())
+                }
+            )
+            .await
+            .is_err()
+        );
+        assert_eq!(std::fs::read(file).unwrap(), b"user bytes");
+        core.shutdown().await;
+        assert_eq!(
+            execute(
+                core,
+                RecoveryRequest {
+                    instance: instance.id,
+                    generation: 3,
+                    action: RecoveryAction::Retry
+                }
+            )
+            .await
+            .unwrap_err()
+            .kind,
+            super::super::errors::UiErrorKind::Shutdown
+        );
+    }
+}
