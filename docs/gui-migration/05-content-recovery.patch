+impl From<ContentError> for UiError {
+    fn from(error: ContentError) -> Self {
+        let (kind, summary) = match &error {
+            ContentError::Busy(_) => (UiErrorKind::Busy, "Instance is busy; wait before retrying recovery".into()),
+            ContentError::RecoveryPending(_) | ContentError::RecoveryConflict { .. } => (UiErrorKind::RecoveryRequired, "Recovery could not finish. Preserve or move the conflicting file, then retry; abandoning keeps files in place.".into()),
+            ContentError::Task(sonata_launcher_core::operations::TaskError::ShuttingDown) => (UiErrorKind::Shutdown, "Launcher is closing; recovery admission is disabled".into()),
+            _ => (UiErrorKind::Other, error.to_string()),
+        };
+        Self::caused_by(kind, summary, error)
+    }
+}
