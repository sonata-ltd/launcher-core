+fn recovery_panel<'a>(kit: &Luminate, state: &'a RecoveryState) -> Element<'a, Message> {
+    let theme = kit.theme();
+    let body = TextStyle::text(TextSize::Sm, iced::font::Weight::Normal);
+    let enabled = !state.loading && !state.busy;
+    let mut panel = column![styled_text(
+        "Восстановление установки",
+        theme.typography.emphasis
+    )]
+    .spacing(theme.spacing.md);
+    if state.busy {
+        panel = panel.push(styled_text(
+            "Завершаем восстановление — дождитесь сохранения журнала",
+            theme.typography.emphasis,
+        ));
+    } else if state.pending.is_empty() && state.error.is_none() {
+        panel = panel.push(styled_text(
+            if state.loading {
+                "Проверяем незавершённые установки…"
+            } else {
+                "Незавершённых установок нет"
+            },
+            body,
+        ));
+    }
+    if let Some(error) = &state.error {
+        panel = panel.push(styled_text(error.summary.clone(), body));
+        panel = panel.push(
+            kit.button(
+                Button::new("Копировать подробности")
+                    .hierarchy(ButtonHierarchy::Tertiary)
+                    .on_press(Message::CopyRecoveryDetails(error.details.clone())),
+            ),
+        );
+    }
+    if !state.pending.is_empty() {
+        panel = panel.push(styled_text("Сохраните или переместите конфликтующий файл и повторите восстановление. Отказ удаляет только выбранный журнал и его leases, не файлы.", body));
+        panel = panel.push(
+            kit.button(
+                Button::new("Повторить восстановление")
+                    .on_press_maybe(enabled.then_some(Message::RetryRecovery)),
+            ),
+        );
+        for operation in &state.pending {
+            panel = panel.push(
+                column![
+                    styled_text(format!("Операция: {operation}"), body),
+                    kit.button(
+                        Button::new("Отказаться, сохранив файлы…")
+                            .hierarchy(ButtonHierarchy::Secondary)
+                            .on_press_maybe(
+                                enabled.then_some(Message::AskAbandon(operation.clone()))
+                            )
+                    ),
+                ]
+                .spacing(theme.spacing.sm),
+            );
+        }
+    }
+    if let Some(operation) = &state.confirmation {
+        panel = panel.push(column![
+            styled_text(format!("Отказаться от восстановления {operation}? Все файлы останутся на месте; этот журнал больше не будет повторён."), body),
+            row![
+                kit.button(Button::new("Подтвердить отказ").hierarchy(ButtonHierarchy::Secondary).on_press_maybe(enabled.then_some(Message::AbandonRecovery(operation.clone())))),
+                kit.button(Button::new("Назад").hierarchy(ButtonHierarchy::Tertiary).on_press(Message::CancelAbandon)),
+            ].spacing(theme.spacing.md),
+        ].spacing(theme.spacing.md));
+    }
+    panel.into()
