 impl Mods {
+    fn load_recovery(&mut self) -> Action<Message> {
+        let Some(generation) = self.recovery.load() else {
+            return Action::none();
+        };
+        let core = self.cx.core.clone();
+        let instance = self.cx.instance_id;
+        Action::task(Task::perform(
+            async move {
+                core.content()
+                    .pending_recovery(instance)
