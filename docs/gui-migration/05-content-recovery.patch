+                    .map_err(UiError::from)
+            },
+            move |result| Message::RecoveryLoaded(generation, result),
+        ))
+    }
+
+    fn run_recovery(&mut self, action: RecoveryAction) -> Action<Message> {
+        if self.browser.active() {
+            return Action::none();
+        }
+        let Some(request) = self.recovery.begin(action) else {
+            return Action::none();
+        };
+        let generation = request.generation;
+        let core = self.cx.core.clone();
+        Action::task(Task::perform(
+            content_recovery::execute(core, request),
+            move |result| Message::RecoveryFinished(generation, result),
+        ))
+    }
