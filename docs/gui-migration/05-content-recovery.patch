+        assert!(page.recovery.confirmation.is_none());
+        let _ = page.update(Message::AskAbandon("pending-operation".into()));
+        let _ = page.update(Message::AbandonRecovery("pending-operation".into()));
+        assert!(page.recovery.busy);
+        let _ = page.update(Message::Poll);
+        assert!(!page.recovery.loading);
+        core.shutdown().await;
+    }
+
+    #[test]
+    fn recovery_panel_exposes_confirmation_and_busy_feedback() {
+        let kit = Luminate::with_theme(Theme::LIGHT);
+        let mut state = RecoveryState::new(7.into());
+        state.pending = vec!["pending-operation".into()];
+        state.ask_abandon("pending-operation".into());
+        let visible = labels(recovery_panel(&kit, &state));
+        assert!(visible.iter().any(|text| text == "Подтвердить отказ"));
+        assert!(
+            visible
+                .iter()
+                .any(|text| text.contains("Все файлы останутся на месте"))
+        );
+        state
+            .begin(RecoveryAction::Abandon("pending-operation".into()))
+            .unwrap();
+        let visible = labels(recovery_panel(&kit, &state));
+        assert!(!visible.iter().any(|text| text == "Подтвердить отказ"));
+        assert!(
+            visible
+                .iter()
+                .any(|text| text.contains("дождитесь сохранения журнала"))
+        );
+    }
+}
