index 0000000..6ca4194
--- /dev/null
+++ b/src/bridge/errors.rs
@@ -0,0 +1,112 @@
+//! Presentation is a projection of typed causes, never a parser of error text.
+use sonata_launcher_core::{instance::error::InstanceError, java::error::JavaError};
+use std::{error::Error, fmt, sync::Arc};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum UiErrorKind {
+    Busy,
+    RecoveryRequired,
+    Shutdown,
+    InvalidSettings,
+    Java,
+    Other,
+}
+
+#[derive(Debug, Clone)]
+pub struct UiError {
+    pub kind: UiErrorKind,
+    pub summary: String,
+    pub details: String,
+    pub source: Option<Arc<dyn Error + Send + Sync>>,
+}
+
+impl UiError {
+    fn caused_by<E: Error + Send + Sync + 'static>(
+        kind: UiErrorKind,
+        summary: String,
+        error: E,
+    ) -> Self {
+        let mut details = error.to_string();
+        let mut cause = error.source();
+        for _ in 0..32 {
+            let Some(error) = cause else { break };
+            details.push_str(&format!("\nCaused by: {error}"));
+            cause = error.source();
+        }
+        Self {
+            kind,
+            summary,
+            details,
+            source: Some(Arc::new(error)),
+        }
+    }
+}
+impl From<InstanceError> for UiError {
+    fn from(error: InstanceError) -> Self {
+        let (kind, summary) = match &error {
+            InstanceError::Busy(_) => (
+                UiErrorKind::Busy,
+                "Instance is busy; wait for the current operation".into(),
+            ),
+            InstanceError::ContentRecoveryPending(_) => (
+                UiErrorKind::RecoveryRequired,
+                "Content recovery is required before continuing".into(),
+            ),
+            InstanceError::Task(sonata_launcher_core::operations::TaskError::ShuttingDown) => (
+                UiErrorKind::Shutdown,
+                "Launcher is closing; new work is disabled".into(),
+            ),
+            InstanceError::InvalidMemoryRange { .. } | InstanceError::InvalidJvmArguments => {
+                (UiErrorKind::InvalidSettings, error.to_string())
+            }
+            _ => (UiErrorKind::Other, error.to_string()),
+        };
+        Self::caused_by(kind, summary, error)
+    }
+}
+impl From<JavaError> for UiError {
+    fn from(error: JavaError) -> Self {
+        Self::caused_by(UiErrorKind::Java, error.to_string(), error)
+    }
+}
+impl From<String> for UiError {
+    fn from(message: String) -> Self {
+        Self {
+            kind: UiErrorKind::Other,
+            summary: message.clone(),
+            details: message,
+            source: None,
+        }
+    }
+}
+impl From<&str> for UiError {
+    fn from(message: &str) -> Self {
+        message.to_owned().into()
+    }
+}
+impl fmt::Display for UiError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.summary)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn misleading_text_is_not_policy_and_typed_cause_survives_clone() {
+        let text: UiError = "launcher is shutting down; content recovery pending".into();
+        assert_eq!(text.kind, UiErrorKind::Other);
+        assert!(text.source.is_none());
+        let typed: UiError = InstanceError::ContentRecoveryPending(7.into()).into();
+        let copy = typed.clone();
+        assert_eq!(copy.kind, UiErrorKind::RecoveryRequired);
+        assert!(matches!(
+            copy.source.unwrap().downcast_ref::<InstanceError>(),
+            Some(InstanceError::ContentRecoveryPending(_))
+        ));
+        let shutdown: UiError =
+            InstanceError::Task(sonata_launcher_core::operations::TaskError::ShuttingDown).into();
+        assert_eq!(shutdown.kind, UiErrorKind::Shutdown);
+    }
+}
