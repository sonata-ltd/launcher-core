+
+#[derive(Debug, PartialEq, Eq)]
+enum RecoveryAction {
+    Validate,
+    Reinstall,
+    Inspect,
+}
+fn recovery_action(error: &ManagedJavaError) -> RecoveryAction {
+    match error.code {
+        ManagedJavaErrorKind::Validation | ManagedJavaErrorKind::Registration => {
+            RecoveryAction::Validate
+        }
+        ManagedJavaErrorKind::Download
+        | ManagedJavaErrorKind::Checksum
+        | ManagedJavaErrorKind::Extract
+        | ManagedJavaErrorKind::Storage
+        | ManagedJavaErrorKind::Catalog
+            if error.retryable =>
+        {
+            RecoveryAction::Reinstall
+        }
+        _ => RecoveryAction::Inspect,
+    }
+}
+
