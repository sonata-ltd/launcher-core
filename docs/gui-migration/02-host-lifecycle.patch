@@ -0,0 +1,83 @@
+//! Host policy: credentials and application close are not core environment reads.
+use sonata_launcher_core::{Config, GlobalState, operations::TaskResult};
+use std::sync::Arc;
+
+pub fn host_config(key: Option<String>) -> Config {
+    Config {
+        curseforge_api_key: key.filter(|key| !key.trim().is_empty()),
+        ..Config::init()
+    }
+}
+
+#[derive(Default)]
+pub struct CloseState {
+    waiting: bool,
+}
+
+impl CloseState {
+    /// Repeated native close requests must not spawn another shutdown future.
+    pub fn request(&mut self) -> bool {
+        if self.waiting {
+            return false;
+        }
+        self.waiting = true;
+        true
+    }
+
+    pub fn waiting(&self) -> bool {
+        self.waiting
+    }
+}
+
+pub async fn shutdown(core: Arc<GlobalState>) -> Vec<TaskResult> {
+    // Never timeout/abort: owned core workers cover SQL commit and cleanup.
+    core.shutdown().await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn host_injects_credentials_without_mutating_the_process_environment() {
+        assert!(host_config(None).curseforge_api_key.is_none());
+        assert!(host_config(Some(" \t".into())).curseforge_api_key.is_none());
+        assert_eq!(
+            host_config(Some("fixture-key".into()))
+                .curseforge_api_key
+                .as_deref(),
+            Some("fixture-key")
+        );
+    }
+
+    #[test]
+    fn repeated_close_requests_keep_one_waiting_shutdown() {
+        let mut close = CloseState::default();
+        assert!(!close.waiting());
+        assert!(close.request());
+        assert!(close.waiting());
+        assert!(!close.request());
+    }
+
+    #[async_std::test]
+    async fn gui_shutdown_waits_for_core_and_seals_install_admission() {
+        let root = tempfile::tempdir().unwrap();
+        let core = Arc::new(
+            GlobalState::new(Config {
+                root_override: Some(root.path().into()),
+                discover_java_on_startup: false,
+                ..host_config(None)
+            })
+            .await
+            .unwrap(),
+        );
+        let result = shutdown(core.clone()).await;
+        assert!(result.iter().all(|task| task.error.is_none()));
+        assert!(matches!(
+            core.instances().install(1.into()).await,
+            Err(sonata_launcher_core::instance::error::InstanceError::Task(
+                _
+            ))
+        ));
+    }
+}
