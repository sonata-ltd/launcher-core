@@ -0,0 +1,224 @@
+use super::*;
+use sonata_launcher_core::operations::{
+    OperationResult,
+    message::{
+        stage::{OperationStage, StageSnapshot, StageStatus},
+        status::{LifeCycle, Progress},
+    },
+};
+
+pub fn empty() -> OperationReconciliation {
+    OperationReconciliation {
+        active: vec![],
+        completed: vec![],
+    }
+}
+pub fn snapshot(id: u32, instance: i64, stages: &[OperationStage]) -> OperationSnapshot {
+    OperationSnapshot {
+        id: serde_json::from_value(serde_json::json!(id)).unwrap(),
+        name: "not parsed".into(),
+        subject: Some(OperationSubject::InstanceInstall {
+            instance: instance.into(),
+        }),
+        stage: None,
+        stages: stages
+            .iter()
+            .map(|stage| StageSnapshot {
+                stage: *stage,
+                status: StageStatus::Pending,
+                progress: Progress::Indeterminable,
+                reason: None,
+            })
+            .collect(),
+        status: LifeCycle::Started,
+        progress: Progress::Indeterminable,
+        message: None,
+    }
+}
+pub fn active(snapshot: OperationSnapshot) -> OperationReconciliation {
+    OperationReconciliation {
+        active: vec![snapshot],
+        completed: vec![],
+    }
+}
+fn completed(mut snapshot: OperationSnapshot, outcome: Outcome) -> OperationReconciliation {
+    snapshot.status = LifeCycle::Completed;
+    OperationReconciliation {
+        active: vec![],
+        completed: vec![OperationResult {
+            snapshot,
+            outcome,
+            finished_at: chrono::Utc::now(),
+        }],
+    }
+}
+
+#[test]
+fn unrelated_domains_and_old_same_instance_cannot_claim_pending_install() {
+    let mut ops = Ops::default();
+    let old = snapshot(1, 7, &[]);
+    ops.begin(
+        7.into(),
+        "install",
+        &completed(old.clone(), Outcome::Completed),
+    );
+    for subject in [
+        None,
+        Some(OperationSubject::ContentInstall {
+            instance: 7.into(),
+            installation: Default::default(),
+        }),
+        Some(OperationSubject::ManagedInstall {
+            installation: Default::default(),
+        }),
+        Some(OperationSubject::ManagedValidation {
+            installation: Default::default(),
+        }),
+        Some(OperationSubject::InstanceInstall { instance: 8.into() }),
+    ] {
+        let mut foreign = snapshot(2, 7, &[]);
+        foreign.subject = subject;
+        ops.reconcile(&active(foreign));
+        assert!(
+            ops.running
+                .as_ref()
+                .unwrap()
+                .stages
+                .operation_id()
+                .is_none()
+        );
+    }
+    ops.reconcile(&completed(old, Outcome::Completed));
+    assert!(ops.is_busy());
+    ops.reconcile(&active(snapshot(3, 7, &[])));
+    assert_eq!(
+        ops.running.as_ref().unwrap().stages.operation_id(),
+        Some(snapshot(3, 7, &[]).id)
+    );
+}
+
+#[test]
+fn initial_and_overflow_views_restore_active_and_terminal_without_caller() {
+    let mut ops = Ops::default();
+    let mut s = snapshot(9, 7, &[OperationStage::FetchManifest]);
+    s.stages[0].status = StageStatus::Running;
+    ops.reconcile(&active(s.clone()));
+    let texture = ops.running.as_ref().unwrap().stages.items()[0]
+        .icon_texture
+        .id();
+    s.stages[0].status = StageStatus::Completed;
+    ops.reconcile(&completed(s.clone(), Outcome::Completed));
+    assert!(!ops.is_busy());
+    assert!(ops.last.as_ref().unwrap().result.is_ok());
+    assert_eq!(
+        ops.last.as_ref().unwrap().stages.items()[0]
+            .icon_texture
+            .id(),
+        texture
+    );
+    assert!(matches!(
+        ops.last.as_ref().unwrap().stages.items()[0].state,
+        crate::components::progress_display::StageState::DoneUnknown
+    ));
+    assert!(ops.last.as_ref().unwrap().output.log.lines().is_empty());
+    let mut resubscribed = Ops::default();
+    resubscribed.reconcile(&completed(s, Outcome::Cancelled));
+    assert_eq!(resubscribed.last.unwrap().result.unwrap_err(), "Cancelled");
+}
+
+#[test]
+fn stale_callback_cannot_finish_new_run_and_callback_before_start_can_bind_later() {
+    let mut ops = Ops::default();
+    let first = ops.begin(7.into(), "install", &empty());
+    ops.finish(first, Ok(()));
+    ops.reconcile(&completed(
+        snapshot(1, 7, &[OperationStage::FetchManifest]),
+        Outcome::Completed,
+    ));
+    assert_eq!(ops.last.as_ref().unwrap().stages.items().len(), 1);
+    let next = ops.begin(8.into(), "install", &empty());
+    ops.finish(first, Err("late".into()));
+    assert_eq!(ops.running.as_ref().unwrap().generation, next);
+    ops.finish(next, Ok(()));
+    ops.finish(first, Err("older".into()));
+    assert!(ops.last.unwrap().result.is_ok());
+}
+
+#[test]
+fn pruned_terminal_is_not_success_or_forever_busy() {
+    let mut ops = Ops::default();
+    ops.reconcile(&active(snapshot(1, 7, &[])));
+    ops.reconcile(&empty());
+    assert!(!ops.is_busy());
+    assert!(
+        ops.last
+            .unwrap()
+            .result
+            .unwrap_err()
+            .contains("unavailable")
+    );
+}
+
+#[test]
+fn authoritative_snapshot_wins_over_queued_progress_and_preserves_output() {
+    use sonata_launcher_core::operations::message::output::{OutputLine, ProcessorOutput};
+    let mut ops = Ops::default();
+    let mut s = snapshot(1, 7, &[OperationStage::RunModloaderProcessors]);
+    ops.reconcile(&active(s.clone()));
+    ops.apply(&OperationMessage {
+        operation_id: s.id,
+        data: OperationEvent::Update(OperationUpdate::Output(ProcessorOutput {
+            stage: OperationStage::RunModloaderProcessors,
+            processor_index: 0,
+            revision: 1,
+            lines: vec![OutputLine {
+                id: 1,
+                text: "observed".into(),
+            }],
+        })),
+    });
+    s.stages[0].status = StageStatus::Completed;
+    let terminal = completed(s.clone(), Outcome::Completed);
+    ops.reconcile(&terminal);
+    ops.apply(&OperationMessage {
+        operation_id: s.id,
+        data: OperationEvent::Update(OperationUpdate::Progress {
+            stage: OperationStage::RunModloaderProcessors,
+            status: LifeCycle::InProgress,
+            progress: Progress::Indeterminable,
+            target: None,
+        }),
+    });
+    ops.reconcile(&terminal);
+    assert!(matches!(
+        ops.last.as_ref().unwrap().stages.items()[0].state,
+        crate::components::progress_display::StageState::DoneUnknown
+    ));
+    assert_eq!(ops.last.as_ref().unwrap().output.log.lines(), ["observed"]);
+}
+
+#[async_std::test]
+async fn stream_subscribes_before_initial_signal_and_reports_overflow() {
+    let bus = EventBus::new(1);
+    let mut events = stream(&BusHandle(bus.clone()));
+    assert!(matches!(
+        events.next().await,
+        Some(ObserverEvent::Reconcile)
+    ));
+    for _ in 0..3 {
+        bus.publish(OperationMessage {
+            operation_id: snapshot(1, 7, &[]).id,
+            data: OperationEvent::Start(
+                sonata_launcher_core::operations::message::event::OperationStart { stages: vec![] },
+            ),
+        });
+    }
+    assert!(matches!(
+        events.next().await,
+        Some(ObserverEvent::Reconcile)
+    ));
+    assert!(matches!(
+        events.next().await,
+        Some(ObserverEvent::Core(CoreEvent::Operation(_)))
+    ));
+}
